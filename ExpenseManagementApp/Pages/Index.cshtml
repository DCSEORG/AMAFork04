@page
@model IndexModel
@{
    ViewData["Title"] = "Expense Management System";
}

<div class="expense-container">
    <div class="expense-section">
        <div class="section-header">
            <h2>Expense Management System</h2>
        </div>
        <div class="section-content">
            <h3>Add Expense</h3>
            <form method="post" asp-page-handler="SubmitExpense">
                <div class="form-group">
                    <label for="Amount">Amount:</label>
                    <input type="number" step="0.01" asp-for="Amount" class="form-control" />
                </div>
                
                <div class="form-group">
                    <label for="ExpenseDate">Date:</label>
                    <input type="date" asp-for="ExpenseDate" class="form-control" />
                </div>
                
                <div class="form-group">
                    <label for="Category">Category:</label>
                    <select asp-for="Category" class="form-control">
                        <option value="Travel">Travel</option>
                        <option value="Food">Food</option>
                        <option value="Office Supplies">Office Supplies</option>
                        <option value="Transport">Transport</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label for="Description">Description:</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                </div>
                
                <div class="form-group">
                    <button type="submit" class="btn btn-primary">Submit</button>
                </div>
            </form>
        </div>
    </div>

    <div class="expense-section">
        <div class="section-header">
            <h2>Expenses</h2>
        </div>
        <div class="section-content">
            <form method="post" asp-page-handler="SaveExpenses">
                <div class="form-group">
                    <label for="ExpensesFilter">Filter:</label>
                    <input type="text" asp-for="ExpensesFilter" class="form-control" />
                </div>
                
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Category</th>
                            <th>Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var expense in Model.AllExpenses)
                        {
                            <tr>
                                <td>@expense.Date.ToString("dd/MM/yyyy")</td>
                                <td>@expense.Category</td>
                                <td>£@expense.Amount.ToString("F2")</td>
                                <td>@expense.Status</td>
                            </tr>
                        }
                    </tbody>
                </table>
                
                <div class="form-group">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>

    <div class="expense-section">
        <div class="section-header">
            <h2>Approve Expenses</h2>
        </div>
        <div class="section-content">
            <form method="post" asp-page-handler="ApproveExpenses">
                <div class="form-group">
                    <label>Pending expenses:</label>
                </div>
                
                <div class="form-group">
                    <label for="ApproveFilter">Filter:</label>
                    <input type="text" asp-for="ApproveFilter" class="form-control" />
                </div>
                
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Category</th>
                            <th>Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var expense in Model.PendingExpenses)
                        {
                            <tr>
                                <td>@expense.Date.ToString("dd/MM/yyyy")</td>
                                <td>@expense.Category</td>
                                <td>£@expense.Amount.ToString("F2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                
                <div class="form-group">
                    <button type="submit" class="btn btn-primary">Approve</button>
                </div>
            </form>
        </div>
    </div>
</div>
